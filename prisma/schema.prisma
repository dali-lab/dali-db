// Prisma schema for DALI shared database

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Term {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  startDate DateTime @map("start_date") @db.Timestamptz(6)
  endDate   DateTime @map("end_date") @db.Timestamptz(6)
  /// When true, this term is the operational "current" term (see GET /terms/current). At most one should be true.
  isCurrent Boolean  @default(false) @map("is_current")

  members          Member[]         @relation("MemberTerms")
  membersJoined    Member[]         @relation("JoinedTerm")
  membersStarting  Member[]         @relation("StartingTerm")
  membersGraduated Member[]         @relation("GraduatedTerm")
  projects         Project[]        @relation("ProjectTerms")
  teams            Team[]
  memberTermRoles  MemberTermRole[]
  courses          Course[]
  applications     Application[]
  bids             Bid[]

  @@map("terms")
}

// ============================================
// Users & Members
// ============================================

enum Role {
  FULLSTACK
  DATA
  ENGINES
  AR_VR
  UI_UX
  VIDEO
  INSTRUCTOR
  PM
}

enum Level {
  P1
  P2
  P3
  C
  L
}

// All Dartmouth students who interact with DALI
model User {
  id             String   @id @default(uuid()) @db.Uuid
  dartmouthEmail String   @unique @map("dartmouth_email") @db.VarChar(255)
  firstName      String?  @map("first_name") @db.VarChar(255)
  lastName       String?  @map("last_name") @db.VarChar(255)
  googleId       String?  @unique @map("google_id") @db.VarChar(255)
  picture        String?  @db.Text
  emailVerified  Boolean  @default(false) @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member       Member? // null = regular student, exists = DALI member
  enrollments  Enrollment[]
  applications Application[]

  @@index([dartmouthEmail])
  @@index([googleId])
  @@map("users")
}

model HiredRole { // Track all roles a member has been hired for
  id        String   @id @default(uuid()) @db.Uuid
  role      Role
  memberId  String   @map("member_id") @db.Uuid
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  level     Level
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([memberId])
  @@index([role])
  @@map("hired_roles")
}

model Member {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @unique @map("user_id") @db.Uuid
  imageUrl        String?     @map("image_url") @db.Text
  daliEmail       String      @unique @map("dali_email") @db.VarChar(255)
  hiredRoles      HiredRole[]
  joinedTermId    String      @map("joined_term_id") @db.Uuid
  startingTermId  String?     @map("starting_term_id") @db.Uuid
  termsInDali     Term[]      @relation("MemberTerms")
  isActive        Boolean     @default(true) @map("is_active") // The member is active this term
  isAlum          Boolean     @default(false) @map("is_alum") 
  graduatedTermId String?     @map("graduated_term_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  fullName        String?  @map("full_name") @db.VarChar(255)
  classYear       String?  @map("class_year") @db.VarChar(10)
  major           String?  @db.VarChar(255)
  minor           String?  @db.VarChar(255)
  linkedinUrl     String?  @map("linkedin_url") @db.Text
  notionPageId    String?  @unique @map("notion_page_id") @db.VarChar(255)
  currentRole     String?  @map("current_role") @db.VarChar(255)
  roles           String[] @default([])
  coreRoleNames   String[] @default([]) @map("core_role_names")

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedTerm      Term             @relation("JoinedTerm", fields: [joinedTermId], references: [id])
  startingTerm    Term?            @relation("StartingTerm", fields: [startingTermId], references: [id])
  graduatedTerm   Term?            @relation("GraduatedTerm", fields: [graduatedTermId], references: [id])
  courses         Course[]         // Courses they instruct
  team            Team?            @relation("TeamMembers", fields: [teamId], references: [id])
  teamId          String?          @db.Uuid
  memberTermRoles MemberTermRole[]
  bids            Bid[]
  bidsAsMentor    Bid[]            @relation("BidMentor")
  accessGroups    AccessGroupMember[]

  @@index([daliEmail])
  @@index([isActive])
  @@index([joinedTermId])
  @@index([startingTermId])
  @@index([notionPageId])
  @@map("members")
}

model MemberTermRole {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @map("member_id") @db.Uuid
  termId   String @map("term_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])
  role     Role

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id])

  @@unique([memberId, termId, projectId, role])
  @@index([memberId])
  @@index([termId])
  @@index([projectId])
  @@map("member_term_roles")
}

// ============================================
// Projects, Partners, and Teams
// ============================================

enum ProjectStatus {
  ACCEPTED
  IN_INTERVIEW
  REJECTED
  ACTIVE
  SHIPPED
  INACTIVE
  ON_HOLD
}

model Partner {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  email         String    @unique @map("email") @db.VarChar(255)
  googleId      String?   @unique @map("google_id") @db.VarChar(255)
  picture       String?   @db.Text
  emailVerified Boolean   @default(false) @map("email_verified")
  projects      Project[]
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([googleId])
  @@map("partners")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(255)
  termsInDali     Term[]        @relation("ProjectTerms")
  teams           Team[]
  status          ProjectStatus @default(SHIPPED) @map("status")

  // Public-facing display fields (from public Notion DB)
  description     String?       @db.Text
  sectors         String[]      @default([])
  product         String[]      @default([])
  techStack       String[]      @map("tech_stack") @default([])
  coverImage      String?       @map("cover_image") @db.Text
  projectUrls     Json          @default("[]") @map("project_urls")
  partnerNames    String[]      @default([]) @map("partner_names")
  publicNotionPageId String?    @unique @map("public_notion_page_id") @db.VarChar(255)
  isPublic           Boolean    @default(false) @map("is_public")

  // Internal operational fields
  partnerEmail    String?       @map("partner_email") @db.VarChar(255)
  teamEmail       String?       @map("team_email") @db.VarChar(255)
  weeklySchedule  String?       @map("weekly_schedule") @db.Text
  zoomLink        String?       @map("zoom_link") @db.Text
  figmaUrl        String?       @map("figma_url") @db.Text
  figjamUrl       String?       @map("figjam_url") @db.Text
  teamDriveUrl    String?       @map("team_drive_url") @db.Text
  imageAssetsUrl  String?       @map("image_assets_url") @db.Text
  gcalendarUrl    String?       @map("gcalendar_url") @db.Text

  repos           Repo[]
  notionPageId    String?       @unique @map("notion_page_id") @db.VarChar(255)
  memberTermRoles MemberTermRole[]
  bidsPref1       Bid[]         @relation("BidPref1")
  bidsPref2       Bid[]         @relation("BidPref2")
  bidsPref3       Bid[]         @relation("BidPref3")
  bidsAssigned    Bid[]         @relation("BidAssigned")
  partnerId       String?       @map("partner_id") @db.Uuid
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([notionPageId])
  @@index([publicNotionPageId])
  @@index([partnerEmail])
  @@map("projects")
}

enum RepoType {
  FULLSTACK
  FRONTEND
  BACKEND
  DATA
  AGENT
  OTHER
}

model Repo {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      RepoType
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId])
  @@map("repos")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  projectId   String   @map("project_id") @db.Uuid
  termId      String   @map("term_id") @db.Uuid
  members     Member[] @relation("TeamMembers")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project     Project  @relation(fields: [projectId], references: [id])
  term        Term     @relation(fields: [termId], references: [id])

  @@map("teams")
}

// ============================================
// Education (Courses & Enrollments)
// ============================================

enum CourseType {
  WORKSHOP
  MINISERIES
}

model Course {
  id          String     @id @default(uuid()) @db.Uuid
  title       String     @db.VarChar(255)
  termId      String     @map("term_id") @db.Uuid
  term        Term       @relation(fields: [termId], references: [id])
  description String?    @db.Text
  courseType  CourseType @default(WORKSHOP) @map("course_type")
  isPublic    Boolean    @default(true) @map("is_public")

  instructorId String? @map("instructor_id") @db.Uuid
  instructor   Member? @relation(fields: [instructorId], references: [id])

  enrollments Enrollment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([instructorId])
  @@index([courseType])
  @@map("courses")
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// ============================================
// Bids
// ============================================

enum ProjectPreference {
  MENTOR
  CONTRIBUTOR
  NONE
}

model Bid {
  id              String    @id @default(uuid()) @db.Uuid
  notionPageId    String?   @unique @map("notion_page_id") @db.VarChar(255)

  memberId        String    @map("member_id") @db.Uuid
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  termId          String    @map("term_id") @db.Uuid
  term            Term      @relation(fields: [termId], references: [id])

  // Project preferences
  projectPref1Id  String?   @map("project_pref_1_id") @db.Uuid
  projectPref1    Project?  @relation("BidPref1", fields: [projectPref1Id], references: [id])
  projectPref2Id  String?   @map("project_pref_2_id") @db.Uuid
  projectPref2    Project?  @relation("BidPref2", fields: [projectPref2Id], references: [id])
  projectPref3Id  String?   @map("project_pref_3_id") @db.Uuid
  projectPref3    Project?  @relation("BidPref3", fields: [projectPref3Id], references: [id])

  // Role preferences (stored as strings — e.g. "UI/UX Des", "Fullstack Dev")
  rolePref1       String?   @map("role_pref_1") @db.VarChar(255)
  rolePref2       String?   @map("role_pref_2") @db.VarChar(255)
  rolePref3       String?   @map("role_pref_3") @db.VarChar(255)

  // Assignment (set by domain leads)
  assignedProjectId String? @map("assigned_project_id") @db.Uuid
  assignedProject Project?  @relation("BidAssigned", fields: [assignedProjectId], references: [id])
  assignedRole    String?   @map("assigned_role") @db.VarChar(255)

  // Preferences & availability
  preference      ProjectPreference @default(CONTRIBUTOR) @map("preference")
  hoursPerWeek    String?   @map("hours_per_week") @db.VarChar(50)
  isMentorThisTerm Boolean  @default(false) @map("is_mentor_this_term")
  isOnCoreThisTerm Boolean  @default(false) @map("is_on_core_this_term")

  // Free-text fields
  interest        String?   @db.Text
  roleQuestion1   String?   @map("role_question_1") @db.Text
  roleQuestion2   String?   @map("role_question_2") @db.Text
  roleQuestion3   String?   @map("role_question_3") @db.Text
  workshopInterest String?  @map("workshop_interest") @db.Text
  instructorReason String?  @map("instructor_reason") @db.Text
  allLabIdea      String?   @map("all_lab_idea") @db.Text
  preferWith      String?   @map("prefer_with") @db.Text
  preferNotWith   String?   @map("prefer_not_with") @db.Text
  otherNotes      String?   @map("other_notes") @db.Text
  otherInvolvement String[] @default([]) @map("other_involvement")

  // Mentorship overrides (admin-set, null = not overridden)
  mentorOptOut    Boolean?  @map("mentor_opt_out")
  mentorId        String?   @map("mentor_id") @db.Uuid
  mentor          Member?   @relation("BidMentor", fields: [mentorId], references: [id])
  externalMentor  String?   @map("external_mentor") @db.VarChar(255)

  // Migration status
  addedToAssignments Boolean @default(false) @map("added_to_assignments")
  readyToMigrate  Boolean   @default(false) @map("ready_to_migrate")

  submittedAt     DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([memberId])
  @@index([termId])
  @@index([assignedProjectId])
  @@index([notionPageId])
  @@map("bids")
}

// ============================================
// Applications
// ============================================

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId         String            @map("term_id") @db.Uuid
  term           Term              @relation(fields: [termId], references: [id])
  status         ApplicationStatus @default(PENDING)
  rolesApplied   Role[]            @map("roles_applied")
  portfolioUrl   String?           @map("portfolio_url") @db.Text
  resumeUrl      String?           @map("resume_url") @db.Text
  statement      String?           @db.Text
  reviewerNotes  String?           @map("reviewer_notes") @db.Text
  submittedAt    DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([termId])
  @@index([status])
  @@map("applications")
}

// ============================================
// Access Control
// ============================================

model AccessGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members AccessGroupMember[]

  @@map("access_groups")
}

model AccessGroupMember {
  groupId  String      @map("group_id")  @db.Uuid
  memberId String      @map("member_id") @db.Uuid
  group    AccessGroup @relation(fields: [groupId],  references: [id], onDelete: Cascade)
  member   Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addedAt  DateTime    @default(now()) @map("added_at") @db.Timestamptz(6)

  @@id([groupId, memberId])
  @@index([memberId])
  @@map("access_group_members")
}

// ============================================
// Auth
// ============================================

enum AccountType {
  USER
  PARTNER
}

model RefreshToken {
  id          String      @id @default(uuid()) @db.Uuid
  tokenHash   String      @unique @map("token_hash") @db.VarChar(64) // SHA256 hex of the actual token
  accountId   String      @map("account_id") @db.Uuid               // User.id or Partner.id
  accountType AccountType @map("account_type")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, accountType])
  @@map("refresh_tokens")
}
